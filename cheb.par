# ChebFD param file test
filename generate7P
nx 6
ny 6
nz 6
cheb_lam_lo 25
cheb_lam_hi 32
cheb_Np 150
cheb_NS 2000
eps 1e-6
itermax 30
# GPU buffer placement: pageable | explicit | managed (default managed)
# gpu_alloc managed
# Stream the host-resident matrix to the GPU in ~N MiB parts, double-buffered
# against compute (GPU build, ChebFD only; 0 = off). Pairs best with
# gpu_alloc explicit.
# gpu_stream_mb 0
# Fused-kernel column-subblock width for ChebFD (0 = full block width)
# cheb_nb 0
