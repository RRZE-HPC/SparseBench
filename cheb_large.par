# ChebFD larger profile-run param file (for nsys timeline generation)
filename generate7P
nx 32
ny 32
nz 32
cheb_lam_lo 25
cheb_lam_hi 32
cheb_Np 150
cheb_NS 64
eps 1e-6
itermax 10
# GPU build: matrix managed + prefetched, search space streamed from pinned
# host memory in sub-blocks of cheb_nb columns (0 = 16)
cheb_nb 16
